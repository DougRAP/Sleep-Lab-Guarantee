# RAP Sleep Lab — environment
# Copy to .env.local and fill in. With NO Supabase keys the app runs against the
# in-memory seed (lib/data/seed.ts). Set the three Supabase vars to go live, then
# run supabase/schema.sql + supabase/seed.sql in your project.

# Supabase (M2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the light-verify session cookie. Set in any deployed environment
# (a long random string). Falls back to an insecure dev value if unset.
SESSION_SECRET=

# Anthropic — powers the AI sleep concierge (M3) and photo-coach vision (M4).
# OPTIONAL and server-side only (never exposed to the client). With NO key the
# concierge still works, returning scripted, on-persona replies from the journey
# day/phase + tips. Set the key to use the live model.
# ANTHROPIC_API_KEY=
# Model override; defaults to claude-sonnet-5. Alternatives: claude-haiku-4-5
# (cheaper), claude-opus-4-8 (max quality).
# ANTHROPIC_MODEL=
