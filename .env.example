# RAP Sleep Lab — environment
# Copy to .env.local and fill in. With NO Supabase keys the app runs against the
# in-memory seed (lib/data/seed.ts). Set the three Supabase vars to go live, then
# run supabase/schema.sql + supabase/seed.sql in your project.

# Supabase (M2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the light-verify session cookie. Set in any deployed environment
# (a long random string). Falls back to an insecure dev value if unset.
SESSION_SECRET=

# Anthropic — photo-coach vision (M3). Optional; capture degrades gracefully.
# ANTHROPIC_API_KEY=
