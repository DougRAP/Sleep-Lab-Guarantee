# RAP Sleep Lab — environment
# Copy to .env.local and fill in. With NO Supabase keys the app runs against the
# in-memory seed (lib/data/seed.ts). Set the three Supabase vars to go live, then
# run supabase/schema.sql + supabase/seed.sql in your project.

# Supabase (M2) — also THE switch for real accounts (M6).
# With the two NEXT_PUBLIC_ vars set, the app uses Supabase Auth: customers
# create an account (email + password), then link their purchase. With them
# unset it falls back to the original light-verify entry (sales order + last
# name) so nothing dead-ends. Set all three together.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Absolute site URL, used to build password-reset links. Falls back to the
# request's own origin, so it's only needed if that's ever wrong (proxies).
# NEXT_PUBLIC_SITE_URL=https://rap-sleeplab.netlify.app

# Signs the light-verify session cookie — the NO-SUPABASE fallback path only.
# Set in any deployed environment (a long random string). Falls back to an
# insecure dev value if unset. Once Supabase Auth is live, the Supabase session
# is the authentication and this cookie is no longer minted.
SESSION_SECRET=

# Anthropic — powers the AI sleep concierge (M3) and photo-coach vision (M4).
# OPTIONAL and server-side only (never exposed to the client). With NO key the
# concierge still works, returning scripted, on-persona replies from the journey
# day/phase + tips. Set the key to use the live model.
# ANTHROPIC_API_KEY=
# Model override; defaults to claude-sonnet-5. Alternatives: claude-haiku-4-5
# (cheaper), claude-opus-4-8 (max quality).
# ANTHROPIC_MODEL=

# Demo day-jumper (M5). Shows a discreet "Demo · preview day" control that sets
# the effective journey day for the browser session, so the whole 90 nights —
# including the day 31–90 exchange window — can be previewed without waiting or
# editing any record. It writes ONLY its own cookie (rap_demo_day); no real data
# is touched.
#
# Defaults to ON when unset, because production is currently the demo.
# TURN IT OFF AT LAUNCH by setting this to false — the control then renders
# nothing at all and every screen follows real time.
NEXT_PUBLIC_DEMO_MODE=true

# Claims-mode demo cut. Hides the sleep-companion layer — Tonight, the Coach
# (/concierge) and Shop — so the app presents only the guarantee/claims
# surfaces (Guarantee, Requests, the fitting). Nav shrinks to Guarantee +
# Requests, hidden routes redirect to /guarantee, and consumers land on
# /guarantee after entry/auth. No code is removed; everything is gated on this
# flag. Defaults to OFF when unset — it is on ONLY when set exactly to "true".
# NEXT_PUBLIC_CLAIMS_MODE=true

# Photo storage (M5): claim photos upload to the Supabase Storage bucket
# "claim-photos" when the Supabase vars above are set. With no Supabase env the
# fitting degrades gracefully — captures stay in-session, photo metadata is
# recorded, and the request still submits.
